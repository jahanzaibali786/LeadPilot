<IfModule mod_rewrite.c>
    DirectoryIndex index.php

    RewriteEngine On
    RewriteBase /

    ErrorDocument 404 /index.php

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block direct access to sensitive Laravel files when deployed at account root.
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|artisan|storage/(framework|logs)|vendor|node_modules|database|resources|routes|config|app|bootstrap)(/|$) - [F,L]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve public assets when the hosting document root is the project root.
    RewriteRule ^(assets|build|css|js|logos)/(.*)$ public/$1/$2 [L]
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
